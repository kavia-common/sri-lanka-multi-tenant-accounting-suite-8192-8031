# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# JWT
JWT_SECRET=please_change_me_in_production
JWT_EXPIRES_IN=8h
JWT_ISSUER=sl-accounting-suite
JWT_AUDIENCE=sl-accounting-frontend

# Compliance (Sri Lanka)
LK_VAT_STANDARD_RATE=0.15

# PostgreSQL (required for real DB runs; tests mock the repository)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=accounting_db
PG_USER=accounting_user
PG_PASSWORD=accounting_password
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=2000
