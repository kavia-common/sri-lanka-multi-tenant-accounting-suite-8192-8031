# Server
PORT=3001
NODE_ENV=development

# Security
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=1h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database (PostgreSQL recommended for row-level security)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auditing
AUDIT_ENABLED=true
AUDIT_REDACT_SENSITIVE=true

# Sri Lanka Tax
SL_VAT_STANDARD_RATE=0.15
SL_WHT_RATE=0.05
SL_NBT_RATE=0.02

# Swagger
SWAGGER_TITLE=Multi-Tenant Accounting API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Comprehensive REST API for multi-tenant accounting with double-entry bookkeeping and Sri Lankan tax compliance scaffold.
