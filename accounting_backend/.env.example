# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Auth
JWT_SECRET=PLEASE_CHANGE_ME
JWT_EXPIRES_IN=8h
JWT_ISSUER=sl-accounting-suite
JWT_AUDIENCE=sl-accounting-frontend

# Security
PASSWORD_SALT_ROUNDS=10

# Sri Lanka tax defaults
LK_VAT_STANDARD_RATE=0.15

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=accounting
PG_USER=account_user
PG_PASSWORD=account_password
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=2000
