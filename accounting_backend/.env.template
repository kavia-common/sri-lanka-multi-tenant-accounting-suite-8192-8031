# ===========================================
# Multi-Tenant Accounting Backend Configuration
# ===========================================

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ===========================================
# Database Configuration
# ===========================================
# NOTE: These environment variables will be provided by the database container
# The database container will set these values automatically

# PostgreSQL Connection (will be set by database container)
DATABASE_URL=postgresql://accounting_user:secure_password@db_host:5432/accounting_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting_db
DB_USER=accounting_user
DB_PASSWORD=secure_password

# ===========================================
# JWT Authentication Configuration
# ===========================================
# IMPORTANT: Change JWT_SECRET in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=24h

# ===========================================
# Rate Limiting Configuration
# ===========================================
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CORS Configuration
# ===========================================
# Allowed origins (use specific domains in production)
CORS_ORIGIN=*

# ===========================================
# Optional Configuration
# ===========================================
# Log level (development only)
LOG_LEVEL=debug

# API Documentation
API_DOCS_ENABLED=true

# ===========================================
# Production Notes
# ===========================================
# In production, ensure:
# 1. JWT_SECRET is at least 32 characters long and secure
# 2. CORS_ORIGIN is set to specific allowed domains
# 3. DATABASE_URL uses secure credentials
# 4. NODE_ENV=production
# 5. Rate limits are appropriate for your use case
